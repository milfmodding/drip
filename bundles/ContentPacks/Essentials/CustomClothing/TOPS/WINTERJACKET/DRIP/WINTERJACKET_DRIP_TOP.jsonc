{
    // "DRIP Jacket" Top
    // This config file serves as a template for what other CustomItem configs will look like.

    // "top" and "bottom" are acceptable values here.
    "type": "top",

    // For "top" clothing, this configures the bundles to use for third- and first-person views.
    "topBundlePath": "TOP.bundle",
    "handsBundlePath": "HANDS.bundle",

    // Co-located bundles are automatically loaded for each item- but here we can specify additional dependencies that
    // those bundles might have.
    "bundleDependencies": {
        "HANDS.bundle": [
            "cubemaps",
            "shaders"
        ],
        "TOP.bundle": [
            "shaders",
            "cubemaps",
            "assets/content/characters/character/skeleton.bundle"
        ]
    },

    // These properties define the cost of the clothing.
    // A normal MongoID can be used here, or two special values are also recognized: "moron" and "georgia"
    // (casing is important!) which are properly routed to our traders.
    "traderId": "moron",
    "loyaltyLevel": 3,
    "profileLevel": 35,
    "standing": 0,
    "currencyId": "MONEY_ROUBLES",
    "price": 420690,

    // If multiple locales are specified, then they'll be used. Otherwise, all locales will have the "en" items injected.
    "locales": {
        "en": {
            "name": "Winter Jacket - DRIP"
        }
    },
    
    // These properties define quests or achievements that are needed before you can buy the clothing.
    "questRequirements": [],
    "achievementRequirements": []
}