<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DRIP</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>2.0.0</Version>
    <!-- The two lines below will set the output path for the binaries -->
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.2" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.2" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Ship the Content Packs alongside the assembly.

      Without this, the Web SDK's default globs pick up *.json and nothing else, so .json5/.jsonc configs, .bundle
      files, trader .jpeg avatars and quest .png icons never reach the output folder. The CustomItems and CustomQuests
      directories then don't exist at runtime, DoIfPathExists skips them, and the mod loads zero items without
      logging a single error.

      Remove-then-Include is deliberate: it stops the SDK's own *.json glob from double-including these files.
      PreserveNewest rather than Always because the full content set is ~6 GB once Parts 1-3 land, and Always would
      re-copy all of it on every build.
    -->
    <Content Remove="bundles\**" />
    <Content Include="bundles\**" CopyToOutputDirectory="PreserveNewest" />

    <!--
      The player-facing options file. Same reason as above: the SDK's default globs cover *.json and would miss a
      .jsonc, so without this DRIP would silently run on defaults no matter what the player edited.
    -->
    <Content Remove="config\**" />
    <Content Include="config\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
